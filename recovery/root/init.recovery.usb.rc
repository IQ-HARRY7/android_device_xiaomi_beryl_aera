# ==================================================================================
#
# usb script for beryl. usb configurations alredy exists in init.recovery.mt6855.rc
# dedicated script for symlinking usb scripts & starting adb/adbd services
#
# ==================================================================================
#

# took from stock init.recovery.mt6855.rc

on property:sys.usb.config=adb && property:sys.usb.configfs=1
    start adbd
    setprop sys.usb.ffs.ready 1
    write /config/usb_gadget/g1/idVendor 0x2717
    write /config/usb_gadget/g1/idProduct 0xFF48

    # Ensure clean state before symlinking
    rm /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}


